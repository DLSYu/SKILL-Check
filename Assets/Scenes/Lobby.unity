MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1636054385}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3b6c8e171b8c8b4fa04179a4d48bda5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messageText: {fileID: 2446468050971903028}
  messages:
  - Hello, iho! Make yourself comfortable in the library.
  - Let me quickly show you around.
  - With my magic, I can transport you to another place depending on the direction
    you go.
  - "To your <color=\"red\">left (kaliwa)</color>, you can visit the <color=\"red\">ruins</color>
    to retrieve some missing statues\u2026"
  - Or to your <color="red">right (kanan)</color>, you can visit the <color="red">forest
    (kagubatan)</color> to put the stories back together.
  - Before you enter a stage though, you have to <color="red"> read a story (Kailangan
    mong magbasa ng kuwento.)</color>. Babaylans like us need to be prepared!
  - If you need anything, nandito naman ako.
  - Alright, off you go!
  librarianImage: {fileID: 1939153619}
  librarianImageOrder:
  - {fileID: 21300000, guid: eafd74ead42f8c64cb1eb409f6c6ca38, type: 3}
  - {fileID: 21300000, guid: eafd74ead42f8c64cb1eb409f6c6ca38, type: 3}
